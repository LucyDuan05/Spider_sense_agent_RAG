ʼѵ�� DHRNet ģ��...');\n      for (let i = 1; i <= 10; i++) {\n        await simulateStep(500);\n        addLog('info', `Epoch ${i}/10: loss=0.${Math.floor(Math.random() * 50 + 50)}, acc=${Math.floor(Math.random() * 5 + 90)}%`);\n      }\n      updateStepStatus(2, 'completed');\n      addLog('success', 'ģ��ѵ�����');\n\n      // ����3: ������ȡ\n      updateStepStatus(3, 'active');\n      addLog('info', '��ȡģ����������...');\n      await simulateStep(1500);\n      updateStepStatus(3, 'completed');\n      addLog('success', '������ȡ���');\n\n      // ����4: MAV����\n      updateStepStatus(4, 'active');\n      addLog('info', '��������ƽ����������...');\n      await simulateStep(1000);\n      updateStepStatus(4, 'completed');\n      addLog('success', 'MAV�������');\n\n      // ����5: �������\n      updateStepStatus(5, 'active');\n      addLog('info', '������������ֲ�...');\n      await simulateStep(1200);\n      updateStepStatus(5, 'completed');\n      addLog('success', '����������');\n\n      // ����6: Weibull���\n      updateStepStatus(6, 'active');\n      addLog('info', '��� Weibull ��ֵ�ֲ�...');\n      await simulateStep(1500);\n      updateStepStatus(6, 'completed');\n      addLog('success', 'Weibull�ֲ�������');\n\n      // ����7: OpenMax����\n      updateStepStatus(7, 'active');\n      addLog('info', '���� OpenMax ������ AUROC...');\n      await simulateStep(1000);\n      updateStepStatus(7, 'completed');\n      addLog('success', 'OpenMax�������');\n\n      addLog('info', '�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T');\n      addLog('success', `ѵ���������! AUROC: ${(Math.random() * 0.1 + 0.85).toFixed(4)}`);\n      addLog('info', '�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T');\n\n    } catch (error) {\n      addLog('error', `ѵ��ʧ��: ${error}`);\n      updateStepStatus(currentStep + 1, 'error');\n    } finally {\n      setIsRunning(false);\n    }\n  };\n\n  const simulateStep = (ms: number) => new Prom